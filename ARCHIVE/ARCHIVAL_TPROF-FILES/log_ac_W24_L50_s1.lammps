# ===========================================================================
#  BP VALIDATION - ARMCHAIR transport (heat flows along Y)
#  Method: Langevin two-bath NEMD (same method as Song et al. ZnO/hBN papers)
#  Everything is written EXPLICITLY - no runtime branching.
#
#  Run:  lmp -in in.bp_armchair -var infile bp_ac_W16_L50.data -var seed 11111
# ===========================================================================
units           metal
dimension       3
boundary        p p p
atom_style      atomic

read_data       ${infile}
read_data       bp_ac_W24_L50.data
Reading data file ...
  orthogonal box = (0 0 0) to (79.104 227.2 32.104598)
  2 by 4 by 1 MPI processor grid
  reading atoms ...
  4800 atoms
  read_data CPU = 0.051 seconds

pair_style      sw
pair_coeff      * * bp.sw B T          # type1 -> B (bottom), type2 -> T (top)

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
timestep        0.0005                  # 0.5 fs

# ---------------- slab geometry along Y -----------------------------------
variable        xL      equal ylo
variable        xH      equal yhi
variable        wall    equal 6.0       # fixed wall thickness (A)
variable        bath    equal 12.0      # reservoir thickness (A)
variable        x1      equal ${xL}+${wall}
variable        x1      equal 0+${wall}
variable        x1      equal 0+6
variable        x2      equal ${x1}+${bath}
variable        x2      equal 6+${bath}
variable        x2      equal 6+12
variable        x4      equal ${xH}-${wall}
variable        x4      equal 227.2-${wall}
variable        x4      equal 227.2-6
variable        x3      equal ${x4}-${bath}
variable        x3      equal 221.2-${bath}
variable        x3      equal 221.2-12

region          rWL   block INF INF ${xL} ${x1} INF INF units box
region          rWL   block INF INF 0 ${x1} INF INF units box
region          rWL   block INF INF 0 6 INF INF units box
region          rWH   block INF INF ${x4} ${xH} INF INF units box
region          rWH   block INF INF 221.2 ${xH} INF INF units box
region          rWH   block INF INF 221.2 227.2 INF INF units box
region          rHOT  block INF INF ${x1} ${x2} INF INF units box
region          rHOT  block INF INF 6 ${x2} INF INF units box
region          rHOT  block INF INF 6 18 INF INF units box
region          rCOLD block INF INF ${x3} ${x4} INF INF units box
region          rCOLD block INF INF 209.2 ${x4} INF INF units box
region          rCOLD block INF INF 209.2 221.2 INF INF units box

group           gWL   region rWL
120 atoms in group gWL
group           gWH   region rWH
120 atoms in group gWH
group           walls union gWL gWH
240 atoms in group walls
group           gHOT  region rHOT
264 atoms in group gHOT
group           gCOLD region rCOLD
240 atoms in group gCOLD
group           mobile subtract all walls
4560 atoms in group mobile

# ---------------- equilibration -------------------------------------------
velocity        all    create 300.0 ${seed} mom yes rot yes dist gaussian
velocity        all    create 300.0 1 mom yes rot yes dist gaussian
velocity        walls  set 0.0 0.0 0.0
fix             fw walls setforce 0.0 0.0 0.0

fix             f1 mobile npt temp 300.0 300.0 0.05 x 0.0 0.0 0.5 y 0.0 0.0 0.5 couple none
thermo          10000
thermo_style    custom step temp press pe lx ly
run             200000                  # 100 ps NPT
